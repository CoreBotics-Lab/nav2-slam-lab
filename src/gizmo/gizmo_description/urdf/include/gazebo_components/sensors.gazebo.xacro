<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- sensor system plugin for gazebo -->
    <gazebo>
        <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
        <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

    <!-- lidar plugin -->
    <xacro:include filename="$(find gizmo_description)/urdf/include/gazebo_components/lidar.gazebo.xacro" />

    <!-- camera plugin -->
    <xacro:include filename="$(find gizmo_description)/urdf/include/gazebo_components/camera.gazebo.xacro" />
    
    <!-- imu plugin -->
    <xacro:include filename="$(find gizmo_description)/urdf/include/gazebo_components/imu.gazebo.xacro" />

</robot>