<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Camera Gazebo Plugin -->
    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose>${camera_optical_frame_o_xyz} 0 0 0</pose>
            <topic>camera/image_raw</topic>
            <camera_info_topic>camera/camera_info</camera_info_topic>
            <gz_frame_id>camera_optical_frame</gz_frame_id>
            <update_rate>30</update_rate>
            <always_on>1</always_on>
            <visualize>true</visualize>
            <camera>
                <!-- Intel RealSense D435 RGB Specs: 69 deg H-FOV (1.20427 rad), 42 deg V-FOV -->
                <horizontal_fov>1.20427</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.105</near>
                    <far>10.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

</robot>
