  <!-- Link base_footprint -->
  <link name="base_footprint"/>
  <!-- Joint base_footprint_base_floor1 -->
  <joint name="base_footprint_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.01163116"/>
    <parent link="base_footprint"/>
    <child link="base_floor1"/>
  </joint>
  <!-- Joint base_floor1_base_floor2 -->
  <joint name="base_floor1_base_floor2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.03350000"/>
    <parent link="base_floor1"/>
    <child link="base_floor2"/>
  </joint>
  <!-- Joint base_floor2_base_floor3 -->
  <joint name="base_floor2_base_floor3_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.02350000"/>
    <parent link="base_floor2"/>
    <child link="base_floor3"/>
  </joint>
  <!-- Joint base_floor1_caster_wheel -->
  <joint name="caster_wheel_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.0556106 -0 0.0035"/>
    <parent link="base_floor1"/>
    <child link="caster_wheel"/>
  </joint>
  <!-- Joint base_floor1_wheel_left -->
  <joint name="left_wheel_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.03 0.0691386 0.01986"/>
    <parent link="base_floor1"/>
    <child link="wheel_left"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10"/>
  </joint>
  <!-- Joint base_floor1_wheel_right -->
  <joint name="right_wheel_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.03 -0.0691386 0.01986"/>
    <parent link="base_floor1"/>
    <child link="wheel_right"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10"/>
  </joint>
  <!-- Left Wheel Surface Friction & Contact Stability -->
  <gazebo reference="wheel_left">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <!-- Right Wheel Surface Friction & Contact Stability -->
  <gazebo reference="wheel_right">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  <!-- Caster Wheel Surface Friction & Contact Stability (Sliding) -->
  <gazebo reference="caster_wheel">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>
  <!-- Gazebo Differential Drive Plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- Wheel Joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <!-- Kinematics & Dimensions -->
      <wheel_separation>0.13827727</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <!-- Torque Limit -->
      <max_torque>50.0</max_torque>
      <!-- Topics & Frames -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <!-- Publishing Options -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
    <!-- Joint State Publisher Plugin for Gazebo -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
