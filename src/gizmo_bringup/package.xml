<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gizmo_bringup</name>
  <version>0.0.0</version>
  <description>Top-level bringup, coordination, and launch orchestration package for the Gizmo 2WD robot.</description>
  <maintainer email="hayisyed@gmail.com">CoreBotics-Lab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>gizmo_description</exec_depend>
  <exec_depend>gizmo_gazebo</exec_depend>
  <exec_depend>gizmo_navigation</exec_depend>
  <exec_depend>gizmo_scripts</exec_depend>
  <exec_depend>gizmo_teleop</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
